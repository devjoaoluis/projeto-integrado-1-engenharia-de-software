        "rentals_contract_boolean": {
          "name": "rentals_contract_boolean",
          "value": "\"rentals\".\"contract_signed\" IN (0, 1)"
        },
        "rentals_signatures_boolean": {
          "name": "rentals_signatures_boolean",
          "value": "\"rentals\".\"signatures_notarized\" IN (0, 1)"
        },
        "rentals_payments_boolean": {
          "name": "rentals_payments_boolean",
          "value": "\"rentals\".\"initial_payments_paid\" IN (0, 1)"
        },
        "rentals_positive_rent": {
          "name": "rentals_positive_rent",
          "value": "\"rentals\".\"monthly_rent\" > 0"
        },
        "rentals_due_day": {
          "name": "rentals_due_day",
          "value": "\"rentals\".\"due_day\" BETWEEN 1 AND 31"
        },
        "rentals_formal_consent": {
          "name": "rentals_formal_consent",
          "value": "\"rentals\".\"parent_rental_id\" IS NULL OR (\"rentals\".\"formal_consent\" IS NOT NULL AND length(trim(\"rentals\".\"formal_consent\")) > 0)"
        },
        "rentals_keys_prerequisites": {
          "name": "rentals_keys_prerequisites",
          "value": "\"rentals\".\"keys_released_at\" IS NULL OR (\"rentals\".\"contract_signed\" = 1 AND \"rentals\".\"signatures_notarized\" = 1 AND \"rentals\".\"initial_payments_paid\" = 1)"
        }
      }
